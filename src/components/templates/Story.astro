---
// 品牌故事 — 五章編輯版型:每章一張大圖 + 標題(數字保留,不顯示英文小標)+ 內文,無卡片框;
// 結尾深色金句 + CTA。文案來源:Doc/FlourFlour_International_Brand_Copy_v5_Premium_*.xlsx、
// Doc/FlourFlour_Poetic_Brand_Quote_4Languages.xlsx。
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import { getDict, localePrefix, type Lang } from '../../i18n';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const p = localePrefix[lang];

// 各章影像:與 i18n 的 story.chapters 以「陣列順序」(01–05)對應,四語系順序一致。
// 圖片維持不動,故不隨文案調整而變動。各章統一 3:2 橫幅;05 為直幅夕陽,3:2 置中會裁掉太陽,
// 故 focus 上偏保留地平線與日落倒影。
type ChapterMedia = { src: string; aspect: string; focus?: string };
const chapterMedia: ChapterMedia[] = [
  { src: '/images/story-river.jpg', aspect: '3 / 2' },
  { src: '/images/story-flour.jpg', aspect: '3 / 2' },
  { src: '/images/story-flower.jpg', aspect: '3 / 2' },
  { src: '/images/story-fold.jpg', aspect: '3 / 2' },
  { src: '/images/story-light.jpg', aspect: '3 / 2', focus: 'center 30%' },
];

// 文案內含 \n 換行、\n\n 段落間距(來自來源試算表的詩意斷句),拆成行陣列供模板逐行渲染。
const toLines = (text: string) => text.split('\n');
---

<Base lang={lang} path="/story" title={t.pageMeta.story.title} description={t.pageMeta.story.description}>
  <PageHeader title={t.story.pageTitle} />

  {t.story.chapters.map((ch, i) => {
    const media = chapterMedia[i];
    return (
    <section class="chapter">
      <div class:list={['container', 'chapter__grid', { 'chapter__grid--flip': i % 2 === 1 }]}>
        <div class="chapter__media reveal-media">
          <img
            src={media.src}
            alt={ch.title}
            class="chapter__photo"
            style={`aspect-ratio: ${media.aspect};${media.focus ? ` object-position: ${media.focus};` : ''}`}
            loading="lazy"
          />
        </div>
        <div class="chapter__text reveal-text">
          <p class="chapter__no">{ch.no}</p>
          <h2>{ch.title}</h2>
          <p class="chapter__body">
            {toLines(ch.body).map((line, li, arr) => (
              <>{line}{li < arr.length - 1 && <br />}</>
            ))}
          </p>
        </div>
      </div>
    </section>
    );
  })}

  <section class="story-quote">
    <div class="container reveal-text">
      <img src="/images/logo-flower-ink.png" alt="" class="story-quote__logo" />
      <p>
        {toLines(t.story.quote).map((line, li, arr) => (
          <>{line}{li < arr.length - 1 && <br />}</>
        ))}
      </p>
    </div>
  </section>

  <section class="section container story-cta reveal-text">
    <a class="link-arrow" href={`${p}/products`}>{t.story.cta} →</a>
  </section>
</Base>

<style>
  .chapter {
    padding-block: var(--space-7);
  }
  .chapter__grid {
    display: grid;
    grid-template-columns: 60fr 40fr;
    gap: var(--space-7);
    align-items: center;
  }
  .chapter__grid--flip .chapter__media {
    order: 2;
  }
  .chapter__no {
    font-family: var(--font-heading-en);
    font-size: var(--text-2xl);
    color: var(--color-muted);
  }
  .chapter__text h2 {
    font-size: var(--text-3xl);
    margin-top: var(--space-2);
  }
  .chapter__body {
    color: var(--color-ink-soft);
    margin-top: var(--space-3);
    max-width: 46ch;
  }
  .chapter__photo {
    width: 100%;
    object-fit: cover;
  }

  .story-quote {
    background: var(--deep-ink);
    color: var(--flour-white);
    text-align: center;
    padding-block: var(--space-8);
    margin-top: var(--space-7);
  }
  .story-quote__logo {
    height: 40px;
    width: auto;
    margin-inline: auto;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }
  .story-quote p {
    font-family: var(--font-heading-locale);
    font-style: var(--display-italic);
    font-size: var(--text-2xl);
    line-height: 1.6;
    max-width: var(--reading-max-width);
    margin-inline: auto;
    margin-top: var(--space-3);
  }
  .story-cta {
    text-align: center;
  }

  @media (max-width: 900px) {
    .chapter {
      padding-block: var(--space-5);
    }
    .chapter__grid,
    .chapter__grid--flip {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .chapter__grid--flip .chapter__media {
      order: 0;
    }
  }
</style>
