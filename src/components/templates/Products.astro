---
// 產品介紹模板 — editorial 版型:安靜頁首 + 分類頁籤(同時只顯示一個分類)+ 產品格線 + 頁尾備註
// 頁籤採漸進增強:SSR 把全部分類完整輸出到 DOM(SEO/無 JS 皆完整,ItemList JSON-LD 涵蓋全部商品),
// 「同時只顯示一個分類」交給 CSS 的 html.js 開關生效(跟 reveal-text/reveal-media 同一套手法),
// JS 負責切換顯示 + 同步網址 hash(可分享/重整後停留在原分類);無 JS 時全部分類維持可見,退回錨點捲動。
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import ProductCard from '../ProductCard.astro';
import ImagePlaceholder from '../ImagePlaceholder.astro';
import { getDict, getBusinessInfo, localePrefix, type Lang } from '../../i18n';
import { getProducts, getCategories } from '../../data/products';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const b = getBusinessInfo(lang);
const p = localePrefix[lang];

// 隱藏分類(例如禮盒還沒準備好)整批排除,不是 CSS 隱藏——不渲染頁籤/內容區,
// 底下的商品也不進 ItemList 結構化資料,搜尋引擎爬不到,之後準備好取消 hidden 即可恢復。
const categories = getCategories(lang).filter((cat) => !cat.hidden);
const hiddenKeys = new Set(getCategories(lang).filter((cat) => cat.hidden).map((cat) => cat.key));
const products = getProducts(lang).filter((item) => !hiddenKeys.has(item.category));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: products.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: item.name,
      description: item.tagline,
      offers: {
        '@type': 'Offer',
        priceCurrency: 'TWD',
        price: item.price,
        availability: 'https://schema.org/InStock',
      },
    },
  })),
};
---

<Base lang={lang} path="/products" title={t.pageMeta.products.title} description={t.pageMeta.products.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <PageHeader eyebrow="PRODUCTS" title={t.products.bannerTitle} />

  <nav class="category-tabs" aria-label="product categories">
    <div class="container category-tabs__inner" role="tablist">
      {categories.map((cat, i) => (
        <a
          href={`#${cat.key}`}
          role="tab"
          id={`tab-${cat.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={cat.key}
          data-tab-link
          class:list={['category-tabs__link', { 'is-active': i === 0 }]}
        >
          {cat.label}
        </a>
      ))}
    </div>
  </nav>

  {categories.map((cat, i) => (
    <section
      id={cat.key}
      role="tabpanel"
      aria-labelledby={`tab-${cat.key}`}
      class:list={['section', 'container', 'product-category', { 'is-active-panel': i === 0 }]}
    >
      {cat.spotlights.length > 0 && (
        <div class="category-spotlights reveal-text">
          <p class="category-spotlights__label">{t.products.ingredientsLabel}</p>
          <div class="category-spotlights__grid">
            {cat.spotlights.map((spot) => (
              <div class="category-spotlight">
                {spot.image ? (
                  <img
                    src={spot.image}
                    alt=""
                    class="category-spotlight__photo"
                    width="160"
                    height="160"
                    loading="lazy"
                  />
                ) : (
                  <ImagePlaceholder
                    label="Ingredient"
                    ratio="1:1"
                    aspect="1 / 1"
                    class="category-spotlight__photo"
                  />
                )}
                <h3 class="category-spotlight__heading">{spot.heading}</h3>
                <p class="category-spotlight__body">{spot.body}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="product-grid">
        {products
          .filter((item) => item.category === cat.key)
          .map((item) => (
            <ProductCard item={item} alcoholLabel={t.products.alcoholLabel} />
          ))}
      </div>
    </section>
  ))}

  <section class="container products-footnote reveal-text">
    <p>{t.products.footnote}</p>
    <a class="link-arrow" href={`tel:${b.phone.replace(/-/g, '')}`}>{t.products.footnoteCta} →</a>
  </section>
</Base>

<style>
  .category-tabs {
    position: sticky;
    top: 0;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
    z-index: 10;
  }
  .category-tabs__inner {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }
  .category-tabs__link {
    text-decoration: none;
    color: var(--color-ink-soft);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color var(--duration-base) var(--ease-editorial),
      border-color var(--duration-base) var(--ease-editorial);
  }
  .category-tabs__link.is-active {
    color: var(--color-ink);
    border-color: var(--color-accent-text);
  }
  /* 無 JS fallback:錨點捲動時預留 sticky 分類列高度;用共用 class 而非硬編分類 id,
     日後從 CMS 新增分類也會自動套用。.section 預設 160px 上下留白是給首頁那種大區塊用的,
     這裡上面已經有頁籤列頂著,不需要再留這麼多空白,改小很多。 */
  .product-category {
    scroll-margin-top: 64px;
    padding-block: var(--space-4);
  }
  /* 頁籤切換的隱藏行為只在 JS 成功執行時套用(見 Base.astro 的 html.js 標記,
     跟 reveal-text/reveal-media 同一套漸進增強手法)。JS 關閉或載入失敗時,
     全部分類維持一般可見,退回原本「整頁列出 + 錨點捲動」的行為,不會被誤藏。 */
  html.js .product-category {
    display: none;
  }
  html.js .product-category.is-active-panel {
    display: block;
  }
  /* 分類食材故事(選填、可多項):只有設定 spotlights 的分類(目前為飲品)才會出現。
     刻意做得比商品格線小很多——這是輔助說明,不是主商品,一排小縮圖+短說明,
     不能跟下面的商品卡搶視覺主從。 */
  .category-spotlights {
    margin-bottom: var(--space-6);
  }
  .category-spotlights__label {
    text-align: center;
    font-family: var(--font-ui);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    margin-bottom: var(--space-3);
  }
  .category-spotlights__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--space-4);
    max-width: 720px;
    margin-inline: auto;
  }
  .category-spotlight {
    text-align: center;
  }
  .category-spotlight__photo {
    width: 100%;
    max-width: 120px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-card);
    margin-inline: auto;
  }
  .category-spotlight__heading {
    font-size: var(--text-sm);
    margin-top: var(--space-2);
  }
  .category-spotlight__body {
    font-size: var(--text-eyebrow);
    line-height: 1.5;
    color: var(--color-ink-soft);
    margin-top: 4px;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .products-footnote {
    text-align: center;
    padding-block: var(--space-7);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-ink-soft);
  }

  @media (max-width: 768px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
    .category-tabs__inner {
      gap: var(--space-2);
      overflow-x: auto;
    }
    .category-spotlights__grid {
      grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
      gap: var(--space-3);
    }
  }
  @media (min-width: 480px) and (max-width: 1120px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  // 分類頁籤:漸進增強。SSR 把全部分類都完整輸出到 DOM,「同時只顯示一個分類」的隱藏行為
  // 完全交給 CSS 的 html.js 開關(見上方樣式)——這裡只負責「切換哪個分類該顯示」+
  // 「依網址 hash 決定初始分類」,JS 沒執行的話 html.js 不會出現,CSS 隱藏規則就不生效,
  // 頁面直接退回原本「整頁列出 + 錨點捲動」的行為。
  const tabs = document.querySelectorAll<HTMLAnchorElement>('[data-tab-link]');
  const panels = document.querySelectorAll<HTMLElement>('.product-category');

  function activate(key: string, updateHash: boolean) {
    const matched = Array.from(panels).some((panel) => panel.id === key);
    if (!matched) return; // 無效 key(例如舊書籤指到已刪除的分類):維持目前顯示狀態

    panels.forEach((panel) => {
      panel.classList.toggle('is-active-panel', panel.id === key);
    });
    tabs.forEach((tab) => {
      const isActive = tab.getAttribute('href') === `#${key}`;
      tab.classList.toggle('is-active', isActive);
      tab.setAttribute('aria-selected', String(isActive));
    });
    if (updateHash) history.replaceState(null, '', `#${key}`);
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', (e) => {
      e.preventDefault();
      const key = tab.getAttribute('href')?.slice(1);
      if (key) activate(key, true);
    });
  });

  const initialKey = location.hash.slice(1) || panels[0]?.id;
  if (initialKey) activate(initialKey, false);
</script>
