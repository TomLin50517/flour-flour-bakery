---
// ContactForm.astro(spec §5.5):必填 + Email 格式驗證、honeypot、v1 不接後端僅顯示成功訊息
export interface Props {
  form: {
    nameLabel: string;
    phoneLabel: string;
    emailLabel: string;
    subjectLabel: string;
    subjectOptions: string[];
    messageLabel: string;
    submitCta: string;
    successMessage: string;
    errorRequired: string;
    errorEmail: string;
    errorSend?: string; // 選填:送出失敗訊息(未提供時用內建中英雙語備援)
    privacyNotePrefix: string;
    privacyNoteLink: string;
    privacyNoteSuffix: string;
  };
  privacyHref: string;
}

const { form, privacyHref } = Astro.props;

// ┌─────────────────────────────────────────────────────────────────────┐
// │ Web3Forms access key — 在此貼上從 web3forms.com 取得的 key。          │
// │ 用 ffule00@gmail.com 申請;送出的表單就會寄到那個信箱。               │
// │ key 可公開(只能寄到已驗證的信箱),放前端無妨。                       │
// │ 留空('')時:表單維持原本行為(僅顯示成功訊息、不寄出),不會壞。     │
// └─────────────────────────────────────────────────────────────────────┘
const WEB3FORMS_ACCESS_KEY = '';
---

<div class="contact-form-wrapper">
  <form
    class="contact-form"
    novalidate
    data-error-required={form.errorRequired}
    data-error-email={form.errorEmail}
    data-error-send={form.errorSend}
    data-web3forms-key={WEB3FORMS_ACCESS_KEY}
  >
    <div class="field">
      <label for="cf-name">{form.nameLabel} *</label>
      <input type="text" id="cf-name" name="name" required />
      <p class="field-error" data-error-for="name" hidden></p>
    </div>
    <div class="field">
      <label for="cf-phone">{form.phoneLabel}</label>
      <input type="tel" id="cf-phone" name="phone" />
    </div>
    <div class="field">
      <label for="cf-email">{form.emailLabel} *</label>
      <input type="email" id="cf-email" name="email" required />
      <p class="field-error" data-error-for="email" hidden></p>
    </div>
    <div class="field">
      <label for="cf-subject">{form.subjectLabel}</label>
      <select id="cf-subject" name="subject">
        {form.subjectOptions.map((opt) => <option value={opt}>{opt}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="cf-message">{form.messageLabel} *</label>
      <textarea id="cf-message" name="message" required rows="5"></textarea>
      <p class="field-error" data-error-for="message" hidden></p>
    </div>

    <!-- honeypot:隱藏欄位防機器人,接後端時沿用(spec §5.5) -->
    <div class="field field--honeypot" aria-hidden="true">
      <label for="cf-company">Company</label>
      <input type="text" id="cf-company" name="company" tabindex="-1" autocomplete="off" />
    </div>

    <!-- 送出邏輯見下方 <script>:已設定 Web3Forms key → 真的寄到信箱;未設定 → 僅顯示成功訊息。 -->
    <button type="submit" class="btn btn--primary">{form.submitCta}</button>

    <p class="contact-form__privacy">
      {form.privacyNotePrefix} <a href={privacyHref}>{form.privacyNoteLink}</a> {form.privacyNoteSuffix}
    </p>
  </form>

  <p class="contact-form__success" hidden>{form.successMessage}</p>
</div>

<style>
  .contact-form {
    flex-direction: column;
    gap: var(--space-3);
  }
  .contact-form:not([hidden]) {
    display: flex;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field label {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
  .field input,
  .field select,
  .field textarea {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 12px 14px;
    font: inherit;
    background: var(--color-bg);
    color: var(--color-ink);
  }
  .field-error {
    color: var(--color-accent-text);
    font-size: var(--text-sm);
    margin: 0;
  }
  .field--honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact-form__privacy {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
  .contact-form__privacy a {
    color: var(--color-accent-text);
  }
  .contact-form__success {
    color: var(--color-ink);
    font-weight: 500;
  }
</style>

<script>
  function isValidEmail(value: string) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
  }

  document.querySelectorAll('.contact-form').forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    const errorRequired = form.dataset.errorRequired || '';
    const errorEmail = form.dataset.errorEmail || '';

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const honeypot = form.querySelector<HTMLInputElement>('input[name="company"]');
      if (honeypot && honeypot.value) return;

      let valid = true;

      (['name', 'email', 'message'] as const).forEach((field) => {
        const input = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${field}"]`);
        const errorEl = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
        if (input && !input.value.trim()) {
          valid = false;
          if (errorEl) {
            errorEl.textContent = errorRequired;
            errorEl.hidden = false;
          }
        } else if (errorEl) {
          errorEl.hidden = true;
        }
      });

      const emailInput = form.querySelector<HTMLInputElement>('[name="email"]');
      const emailError = form.querySelector<HTMLElement>('[data-error-for="email"]');
      if (emailInput && emailInput.value.trim() && !isValidEmail(emailInput.value.trim())) {
        valid = false;
        if (emailError) {
          emailError.textContent = errorEmail;
          emailError.hidden = false;
        }
      }

      if (!valid) return;

      const wrapper = form.closest('.contact-form-wrapper');
      const successEl = wrapper?.querySelector<HTMLElement>('.contact-form__success');
      const showSuccess = () => {
        form.hidden = true;
        if (successEl) successEl.hidden = false;
      };

      const key = form.dataset.web3formsKey || '';
      // 尚未設定 access key → 維持原本行為(僅顯示成功訊息,不實際寄出)。
      if (!key) {
        showSuccess();
        return;
      }

      // 已設定 → 真的送到 Web3Forms(寄到申請 key 時用的信箱 ffule00@gmail.com)。
      const val = (n: string) =>
        (form.querySelector(`[name="${n}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)
          ?.value.trim() || '';
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const originalCta = submitBtn?.textContent || '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.setAttribute('aria-busy', 'true');
      }

      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: key,
          subject: 'FlourFlour 網站聯絡表單',
          from_name: 'FlourFlour Website',
          name: val('name'),
          email: val('email'),
          phone: val('phone'),
          topic: val('subject'), // 用 topic 避免與 Web3Forms 的 email 主旨欄位(subject)衝突
          message: val('message'),
          botcheck: '', // Web3Forms 內建 honeypot 欄位
        }),
      })
        .then((r) => r.json())
        .then((data) => {
          if (data && data.success) {
            showSuccess();
          } else {
            throw new Error((data && data.message) || 'send failed');
          }
        })
        .catch(() => {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.removeAttribute('aria-busy');
            submitBtn.textContent = originalCta;
          }
          const sendError =
            form.dataset.errorSend ||
            '送出失敗,請稍後再試,或直接來電/Email 與我們聯繫。 Sending failed — please try again, or reach us by phone/email.';
          const msgError = form.querySelector<HTMLElement>('[data-error-for="message"]');
          if (msgError) {
            msgError.textContent = sendError;
            msgError.hidden = false;
          }
        });
    });
  });
</script>
