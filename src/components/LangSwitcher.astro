---
// LangSwitcher.astro — 語言切換下拉:收合時直接顯示目前語言的完整原生名稱(如「繁體中文」)+ ▼,
// 而非圖示/縮寫/國旗,讓第一次使用的人一眼就能認出這是語言切換;點開後列出四語系完整名稱。
import { localePrefix, locales, type Lang } from '../i18n';

export interface Props {
  lang: Lang;
  path: string; // 不含語系前綴,如 '/', '/story'
  labels: Record<string, string>;
}

const { lang, path, labels } = Astro.props;
---

<details class="lang-select">
  <summary aria-label={labels.label}>
    <span>{labels[lang]}</span>
    <span class="lang-select__caret" aria-hidden="true">▼</span>
  </summary>
  <ul>
    {locales.map((l) => (
      <li>
        <a href={`${localePrefix[l]}${path}`} aria-current={l === lang ? 'true' : undefined}>
          {labels[l]}
        </a>
      </li>
    ))}
  </ul>
</details>

<style>
  .lang-select {
    position: relative;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }
  .lang-select summary {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    cursor: pointer;
    letter-spacing: 0.04em;
    color: var(--lang-switcher-color, var(--color-ink));
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color var(--duration-base) var(--ease-editorial);
  }
  .lang-select summary::-webkit-details-marker {
    display: none;
  }
  .lang-select summary:hover {
    color: var(--sunset-copper);
  }
  .lang-select__caret {
    font-size: 8px;
    opacity: 0.7;
    transition: transform var(--duration-base) var(--ease-editorial);
  }
  .lang-select[open] .lang-select__caret {
    transform: rotate(180deg);
  }
  .lang-select[open] ul {
    position: absolute;
    top: calc(100% + 14px);
    right: 0;
    margin: 0;
    padding: var(--space-2) 0;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    min-width: 140px;
    z-index: 50;
  }
  .lang-select a {
    display: block;
    padding: 8px var(--space-3);
    text-decoration: none;
    color: var(--color-ink-soft);
    white-space: nowrap;
  }
  .lang-select a:hover {
    color: var(--color-accent-text);
  }
  .lang-select a[aria-current='true'] {
    color: var(--color-ink);
    font-weight: 500;
  }

  /* 手機:語言切換位於全螢幕漢堡選單底部;若維持向下展開,選項會掉出畫面外而選不到。
     改為向上展開(bottom 對齊 summary 頂端),確保選項落在畫面內。 */
  @media (max-width: 900px) {
    .lang-select[open] ul {
      top: auto;
      bottom: calc(100% + 14px);
    }
  }
</style>

<script>
  // 點擊選單外自動收合
  document.querySelectorAll<HTMLDetailsElement>('.lang-select').forEach((menu) => {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  });

  // 切換語系要保留網址的 hash(例如商品頁點了「飲品」頁籤後的 #drink)。href 是伺服端渲染時
  // 算好的純路徑,伺服端看不到 hash。原本在頁面載入時「當下」補一次 hash,但商品頁的分類頁籤
  // 是載入後才用 history.replaceState 改 hash(見 Products.astro),這段 script 早就跑完、
  // 不會再重跑,所以載入後才切頁籤再切語系,hash 還是補不到——改成「點擊當下」才讀取當前
  // hash 並重算目標網址,不管 hash 是什麼時候變的都能補到最新的。
  document.querySelectorAll<HTMLAnchorElement>('.lang-select a').forEach((a) => {
    const base = a.href.split('#')[0];
    a.addEventListener('click', () => {
      if (location.hash) a.href = base + location.hash;
    });
  });
</script>
